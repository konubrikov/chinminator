{
  "manifestVersion": 5,
  "id": "com.example.doublechin-fix",
  "name": {
    "code": "Double Chin Fix",
    "en": "Double Chin Fix (Z-Image)"
  },
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "name": "Photoshop",
    "minVersion": "24.0.0"
  },
  "executioncontext": {
    "startup": "./startup.js"
  },
  "panel": {
    "id": "doublechin-panel",
    "name": "Double Chin Fix",
    "type": "panel",
    "minWidth": 320,
    "minHeight": 480
  },
  "permissions": {
    "domains": [
      { "url": "http://127.0.0.1:8765/*" },
      { "url": "http://localhost:8765/*" }
    ],
    "networkAccess": true
  },
  "icons": [
    { "width": 24, "height": 24, "path": "./icons/icon.png", "scale": [1, 2] }
  ],
  "categories": ["Automation"],
  "allowedByDefault": false
}
